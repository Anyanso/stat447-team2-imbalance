# --- Data: never commit the Kaggle CSV (about 150 MB) ---
data/*.csv

# --- R / RStudio ---
.Rhistory
.RData
.Rproj.user/
.Ruserdata

# --- Quarto render output ---
/.quarto/
*_files/
*.html
*.pdf
!figures/*.pdf

# --- Big intermediate results (keep the small summary .rds files) ---
results/*_raw.rds

# --- OS clutter ---
.DS_Store
Thumbs.db

# --- Simulation chunks (intermediate; the combined sim_results.rds is kept) ---
results/sim_chunks/
results/pilot_chunks/
results/pilot_results.rds
results/real_chunks/
results/real_pilot_chunks/
results/real_pilot_results.rds
results/ens_sim_chunks/
results/ens_real_chunks/

# Wadud's robustness check: copies of the Kaggle data and the large
# held-out prediction files his script writes (all re-created by running it)
results/simulation/fraud_real_data/data/
results/simulation/fraud_real_data/tables/*heldout_predictions.csv
results/simulation/fraud_real_data/tables/*_partial.csv
